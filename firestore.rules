rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User-Dokument: nur der User selbst darf lesen/schreiben.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Lobbies
    match /lobbies/{code} {
      // Jeder eingeloggte User darf lesen (um Code zu prüfen / anzuzeigen)
      // und eine neue Lobby anlegen wenn er sich selbst als host einträgt.
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;
      // Nur der Host darf Rhythm-Settings ändern oder die Lobby löschen.
      allow update, delete: if request.auth != null
                            && resource.data.hostUid == request.auth.uid;

      // Mitglieder — jeder liest, jeder verwaltet nur seinen eigenen Eintrag.
      // Ghost-Members (uid beginnt mit "ghost_") dürfen von jedem authed User
      // geschrieben werden — reines Debug-Feature, kann in Prod raus.
      match /members/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null &&
                     (request.auth.uid == uid || uid.matches('ghost_.*'));
      }

      // Events — jeder liest, jeder darf Events anlegen (Summon).
      // Cloud Function updated `finalized` via Admin-SDK (bypassen Rules).
      match /events/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;

        // Responses — jeder darf seine eigene schreiben. Ghost-Responses
        // (uid ghost_*) dürfen ebenfalls von jedem authed User geschrieben
        // werden. Debug-Feature — vor Prod entfernen.
        match /responses/{uid} {
          allow read: if request.auth != null;
          allow write: if request.auth != null &&
                       (request.auth.uid == uid || uid.matches('ghost_.*'));
        }
      }
    }
  }
}
